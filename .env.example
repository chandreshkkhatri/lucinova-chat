# Get your Google Gemini API Key here https://cloud.google.com/vertex-ai
GOOGLE_GENERATIVE_AI_API_KEY=****

# Model Display Configuration
# Set to "custom" to use Tara naming, "original" to use Gemini naming
NEXT_PUBLIC_MODEL_DISPLAY_MODE=custom

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Email Configuration (Resend)
# Get your API key here: https://resend.com/api-keys
RESEND_API_KEY=****
# Email sender address (must be verified in Resend)
EMAIL_FROM="Delibration <noreply@yourdomain.com>"

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Deployment Protection Bypass (Optional)
# Get this from: Vercel Dashboard → Settings → Deployment Protection → Bypass for Automation
# Required for webhooks to work on protected preview deployments
VERCEL_AUTOMATION_BYPASS_SECRET=****

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****
MONGODB_URI=****

NEXT_PUBLIC_PRO_MONTHLY_PRICE_INR=
PRO_MONTHLY_PRICE_INR=
NEXT_PUBLIC_CURRENCY=