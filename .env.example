NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=AbCdEfGh
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=XyZaBcDe
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pricing Configuration (USD — default for non-IN users)
NEXT_PUBLIC_PRO_MONTHLY_PRICE=20
PRO_MONTHLY_PRICE=20
NEXT_PUBLIC_CURRENCY=USD
CURRENCY=USD

# Pricing Configuration (INR — auto-applied for Indian users)
NEXT_PUBLIC_PRO_MONTHLY_PRICE_INR=999
PRO_MONTHLY_PRICE_INR=999
NEXT_PUBLIC_FEATURE_FLAG_CANVAS_CHAT_TOGGLE=true
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Google OAuth (for social login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****

# Email Configuration (Resend)
# Get your API key here: https://resend.com/api-keys
RESEND_API_KEY=****
# Email sender address (must be verified in Resend)
EMAIL_FROM="Lucidity <noreply@lucidity.chat>"

# Vercel Deployment Protection Bypass (Optional)
# Get this from: Vercel Dashboard → Settings → Deployment Protection → Bypass for Automation
# Required for webhooks to work on protected preview deployments
VERCEL_AUTOMATION_BYPASS_SECRET=****

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****
MONGODB_URI=****

# Razorpay Payment Gateway (Subscription-based)
RAZORPAY_KEY_ID=****
RAZORPAY_KEY_SECRET=****
RAZORPAY_WEBHOOK_SECRET=****
RAZORPAY_ENVIRONMENT=test
# Pre-created Razorpay Plan ID for monthly subscription (USD)
RAZORPAY_PLAN_ID=****
RAZORPAY_EARLY_BIRD_PLAN_ID=****
# Pre-created Razorpay Plan ID for monthly subscription (INR)
RAZORPAY_PLAN_ID_INR=****
RAZORPAY_EARLY_BIRD_PLAN_ID_INR=****
# Cron Job Security
# Generate a random secret for cron job authentication
# Used by /api/cron/reconcile-subscriptions
CRON_SECRET=****

# Admin Operations Security
# Generate a random secret for admin operations (manual activation, etc.)
# Used by /api/admin/activate-subscription
ADMIN_SECRET=****

# TaxJar Integration (for sales tax calculation)
# Get your API key here: https://www.taxjar.com/
# Used to calculate sales tax for US customers
# If not configured, falls back to manual state tax rates
TAXJAR_API_KEY=****

# Get your Google Gemini API Key here https://cloud.google.com/vertex-ai
# Google Gemini AI
# Get your API Key here: https://cloud.google.com/vertex-ai
GOOGLE_GENERATIVE_AI_API_KEY=****
# Optional: Override default model IDs
GOOGLE_GEMINI_PRIMARY_MODEL=gemini-3-pro
GOOGLE_GEMINI_FAST_MODEL=gemini-3-flash-preview

